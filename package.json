{
  "name": "ticketmind-backend",
  "version": "0.1.0",
  "description": "TicketMind backend service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11",
    "npm": ">=10.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "SESSION_SECRET=test-secret STRIPE_SECRET_KEY=sk_test_1 STRIPE_WEBHOOK_SECRET=whsec_1 STRIPE_PRICE_ID_STARTER=price_1 STRIPE_PRICE_ID_GROWTH=price_2 vitest run",
    "test:watch": "SESSION_SECRET=test-secret STRIPE_SECRET_KEY=sk_test_1 STRIPE_WEBHOOK_SECRET=whsec_1 STRIPE_PRICE_ID_STARTER=price_1 STRIPE_PRICE_ID_GROWTH=price_2 vitest",
    "test:one": "SESSION_SECRET=test-secret STRIPE_SECRET_KEY=sk_test_1 STRIPE_WEBHOOK_SECRET=whsec_1 STRIPE_PRICE_ID_STARTER=price_1 STRIPE_PRICE_ID_GROWTH=price_2 vitest run --testNamePattern"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stripe": "^23.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.13.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.3"
  }
}
