{
  "name": "ticketmind-backend",
  "version": "0.1.0",
  "description": "TicketMind backend service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11",
    "npm": ">=10.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:one": "vitest run --testNamePattern"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@jest/globals": "^30.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^20.16.10",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.13.0",
    "supertest": "^7.2.2",
    "vite": "^5.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
