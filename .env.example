NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/ticketmind

# Logging
LOG_LEVEL=info

# Optional runtime metadata
SERVICE_NAME=ticketmind-api
SERVICE_VERSION=0.1.0

# Optional LLM provider configuration (if using external provider)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
SESSION_SECRET="change-this-in-production-to-a-real-random-secret"

# Stripe Config
# Created in the Stripe dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
# Created when adding a webhook endpoint (Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs created in the Stripe dashboard (Products)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_GROWTH=price_...
